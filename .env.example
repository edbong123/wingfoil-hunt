# Site
SITE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-32-plus-random-chars
ADMIN_PASSWORD=change-me

# Supabase (server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Instagram / Meta (Instagram API with Instagram Login)
IG_APP_ID=
IG_APP_SECRET=
IG_WEBHOOK_VERIFY_TOKEN=change-me
IG_USER_ID=             # the Wingfoil professional account id
IG_ACCESS_TOKEN=        # long-lived token for the Wingfoil account
GRAPH_VERSION=v23.0

# Behaviour
DRY_RUN=true            # true = log what would be published instead of posting
DEV_LOGIN=false         # true = allow /api/auth/dev?handle=x login for testing
ROUND_CLOSE_HOUR_UTC=18 # must match the cron schedule in vercel.json
VOTES_PER_IP_PER_ROUND=3
MIN_VOTER_FOLLOWERS=0
MIN_VOTER_MEDIA=1
MIN_VOTES_TO_WIN=1
REPORTS_TO_FLAG=3
CARRY_OVER=true         # approved non-winners move to the next round with votes reset
CRON_SECRET=            # Vercel sets the Authorization header for cron calls with this
